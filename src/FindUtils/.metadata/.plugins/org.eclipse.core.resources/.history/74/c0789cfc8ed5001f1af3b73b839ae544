import java.util.stream.Stream;

public class training {
    public static void main(String[] args) {
        Stream.of(5, 3, 1, 4, 2)
              .map(x -> {
                  System.out.println("map: " + x);
                  return x * x;
              })
              .filter(x -> {
                  System.out.println("filter: " + x);
                  return x >0;
              })
              .sorted()
              .forEach(x -> System.out.println("forEach: " + x));
    }

}